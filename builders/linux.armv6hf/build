#!/bin/sh
set -xe
{
  tar xzv --strip-components=1
  chmod +x striptests && ./striptests
  mkdir "$TARGETNAME"
  cp /etc/cabal.project .
  cabal build --enable-executable-static
  find . -name shellcheck -type f -exec mv {} "$TARGETNAME/" \;
  ls -l "$TARGETNAME"
  "$TARGET-strip" -s "$TARGETNAME/shellcheck"
  ls -l "$TARGETNAME"
  "$TARGET-readelf" -A "$TARGETNAME/shellcheck" | grep "Tag_CPU_arch: v6$"
  qemu-arm -cpu arm1176 "$TARGETNAME/shellcheck" --version
} >&2
tar czv "$TARGETNAME"
