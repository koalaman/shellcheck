-- Copied next to ShellCheck.cabal when building. Options set here under
-- `package *` apply to all dependencies, unlike --ghc-options on the command
-- line, which only applies to ShellCheck itself.
packages: .
with-compiler: arm-linux-gnueabihf-ghc
with-hc-pkg: arm-linux-gnueabihf-ghc-pkg
constraints: hashable -arch-native

package *
  ghc-options: -split-sections -optc-Os -optc-Wl,--gc-sections
