#!/bin/sh
set -xe
{
  tar xzv --strip-components=1
  chmod +x striptests && ./striptests
  mkdir "$TARGETNAME"
  cp /etc/cabal.project .
  cabal build
  find dist*/ -name shellcheck -type f -exec mv {} "$TARGETNAME/" \;
  ls -l "$TARGETNAME"
  # macOS on ARM refuses to run unsigned code. The linker adds an ad-hoc
  # signature, which cctools' strip invalidates but llvm-strip regenerates.
  llvm-strip-18 -s "$TARGETNAME/shellcheck"
  ls -l "$TARGETNAME"
  file "$TARGETNAME/shellcheck" | grep "Mach-O 64-bit ${OSXCROSS%%-*} executable"
} >&2
tar czv "$TARGETNAME"
